datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator serverClient {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  PLACEMENT_ADMIN
  STUDENT
  RECRUITER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AcademicStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
  DETAINED
}

enum AcademicLevel {
  CLASS_10
  CLASS_12
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  SEMESTER
}

enum SkillCategory {
  TECHNICAL
  SOFT_SKILL
  DOMAIN
  TOOL
  LANGUAGE
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RecruiterAccountStatus {
  ACTIVE
  PENDING_APPROVAL
  INACTIVE
  SUSPENDED
}

enum OpportunityType {
  JOB
  INTERNSHIP
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TRAINEESHIP
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum OpportunityStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  CLOSED
  CANCELLED
  ARCHIVED
}

enum StipendPeriod {
  PER_MONTH
  PER_WEEK
  LUMP_SUM
  UNPAID
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  INTERVIEW_SCHEDULED
  SELECTED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  WITHDRAWN
  HIRED_PLACED
}

enum InterviewRoundType {
  ONLINE_ASSESSMENT
  TECHNICAL
  MANAGERIAL
  HR
  GROUP_DISCUSSION
  OTHER
}

enum InterviewMode {
  ONLINE
  IN_PERSON
  TELEPHONIC
}

enum InterviewResult {
  PENDING
  QUALIFIED
  NOT_QUALIFIED
  ON_HOLD
  ABSENT
}

enum InterviewStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

enum PlacementType {
  ON_CAMPUS
  OFF_CAMPUS
  PPO
}

enum PlacementStatus {
  CONFIRMED
  JOINED
  DEFERRED
  RESCINDED
  DECLINED
}

enum DocumentType {
  RESUME
  CERTIFICATE
  MARKSHEET
  INTERNSHIP_CERTIFICATE
  OFFER_LETTER
  ID_PROOF
  OTHER
}

enum NotificationType {
  APPLICATION_UPDATE
  INTERVIEW_SCHEDULED
  OFFER_RELEASED
  DEADLINE_ALERT
  GENERAL
  SYSTEM
}

// ==========================================
// CORE AUTH & USER MANAGEMENT
// ==========================================

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  passwordHash      String
  role              UserRole  @default(STUDENT)
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // 1-to-1 Profile associations
  student           Student?
  recruiter         Recruiter?

  // System associations
  documents         Document[]
  verifiedDocuments Document[] @relation("DocumentVerifier")
  notifications     Notification[]
  auditLogs         AuditLog[]
  statusChanges     ApplicationStatusHistory[]

  @@map("users")
  @@index([role])
  @@index([email])
}

// ==========================================
// ACADEMIC & INSTITUTION STRUCTURE
// ==========================================

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  students    Student[]

  @@map("departments")
}

// ==========================================
// STUDENT PROFILES & PORTFOLIO
// ==========================================

model Student {
  id                  Int             @id @default(autoincrement())
  userId              Int             @unique
  departmentId        Int

  // Personal information
  fullName            String
  profilePhoto        String?
  phone               String?
  dateOfBirth         DateTime?
  gender              Gender?
  address             String?         @db.Text
  city                String?
  state               String?
  country             String?         @default("India")
  pincode             String?

  // Academic information
  studentId           String          @unique // College Roll Number / Student ID
  enrollmentNumber    String          @unique // University Enrollment Number
  course              String                  // e.g. "MCA", "B.Tech"
  program             String                  // e.g. "Master of Computer Applications"
  semester            Int             @default(1)
  graduationYear      Int
  cgpa                Decimal?        @db.Decimal(4, 2)
  percentage          Decimal?        @db.Decimal(5, 2)
  backlogs            Int             @default(0)
  academicStatus      AcademicStatus  @default(ACTIVE)
  isPlacementEligible Boolean         @default(true)

  // Career information
  resumeUrl           String?
  portfolioUrl        String?
  githubUrl           String?
  linkedinUrl         String?
  careerInterests     String?         @db.Text
  preferredRoles      String?         @db.Text
  preferredLocations  String?         @db.Text

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department          Department              @relation(fields: [departmentId], references: [id])
  academicRecords     StudentAcademicRecord[]
  skills              StudentSkill[]
  applications        Application[]
  interviews          Interview[]
  offers              Offer[]
  placements          Placement[]
  documents           Document[]
  certifications      Certification[]
  savedOpportunities  SavedOpportunity[]

  @@map("students")
  @@index([departmentId])
  @@index([graduationYear])
  @@index([cgpa])
  @@index([academicStatus])
  @@index([isPlacementEligible])
}

model StudentAcademicRecord {
  id              Int            @id @default(autoincrement())
  studentId       Int
  level           AcademicLevel
  semesterNumber  Int?
  institution     String
  boardOrUniv     String?
  passingYear     Int
  cgpa            Decimal?       @db.Decimal(4, 2)
  percentage      Decimal?       @db.Decimal(5, 2)
  marksObtained   Decimal?       @db.Decimal(7, 2)
  totalMarks      Decimal?       @db.Decimal(7, 2)
  backlogsCount   Int            @default(0)
  marksheetUrl    String?
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_academic_records")
  @@index([studentId])
  @@index([level])
}

model Skill {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  category      SkillCategory  @default(TECHNICAL)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  studentSkills StudentSkill[]

  @@map("skills")
  @@index([category])
}

model StudentSkill {
  id                Int               @id @default(autoincrement())
  studentId         Int
  skillId           Int
  proficiency       SkillProficiency  @default(BEGINNER)
  yearsOfExperience Decimal?          @db.Decimal(3, 1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@map("student_skills")
  @@index([skillId])
}

model Certification {
  id                  Int       @id @default(autoincrement())
  studentId           Int
  name                String
  issuingOrganization String
  issueDate           DateTime
  expiryDate          DateTime?
  credentialId        String?
  credentialUrl       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("certifications")
  @@index([studentId])
}

// ==========================================
// COMPANY & RECRUITER STRUCTURE
// ==========================================

model Company {
  id                 Int                       @id @default(autoincrement())
  name               String                    @unique
  logoUrl            String?
  industry           String
  website            String?
  description        String                    @db.Text
  headquarters       String
  locations          String?                   @db.Text
  companySize        String?
  contactEmail       String
  contactPhone       String?
  verificationStatus CompanyVerificationStatus @default(PENDING)
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  recruiters         Recruiter[]
  jobs               Job[]
  internships        Internship[]
  interviews         Interview[]
  offers             Offer[]
  placements         Placement[]

  @@map("companies")
  @@index([verificationStatus])
  @@index([isActive])
}

model Recruiter {
  id            Int                    @id @default(autoincrement())
  userId        Int                    @unique
  companyId     Int
  fullName      String
  email         String                 @unique
  phone         String?
  designation   String
  accountStatus RecruiterAccountStatus @default(ACTIVE)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs          Job[]
  internships   Internship[]
  interviews    Interview[]

  @@map("recruiters")
  @@index([companyId])
  @@index([accountStatus])
}

// ==========================================
// OPPORTUNITIES: JOBS & INTERNSHIPS
// ==========================================

model Job {
  id                  Int                  @id @default(autoincrement())
  companyId           Int
  recruiterId         Int?
  title               String
  description         String               @db.Text
  responsibilities    String               @db.Text
  requirements        String               @db.Text
  requiredSkills      String               @db.Text
  employmentType      EmploymentType       @default(FULL_TIME)
  location            String
  workMode            WorkMode             @default(ON_SITE)
  salaryMin           Decimal              @db.Decimal(12, 2)
  salaryMax           Decimal              @db.Decimal(12, 2)
  salaryCurrency      String               @default("INR")
  salaryBreakup       String?              @db.Text
  vacancies           Int                  @default(1)
  applicationDeadline DateTime
  selectionProcess    String?              @db.Text
  status              OpportunityStatus    @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter           Recruiter?           @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  eligibilityCriteria EligibilityCriteria?
  interviewRounds     InterviewRound[]
  applications        Application[]
  interviews          Interview[]
  offers              Offer[]
  placements          Placement[]
  savedOpportunities  SavedOpportunity[]

  @@map("jobs")
  @@index([companyId])
  @@index([status])
  @@index([applicationDeadline])
}

model Internship {
  id                  Int                  @id @default(autoincrement())
  companyId           Int
  recruiterId         Int?
  title               String
  description         String               @db.Text
  responsibilities    String               @db.Text
  duration            String
  startDate           DateTime?
  endDate             DateTime?
  stipendAmount       Decimal              @default(0) @db.Decimal(10, 2)
  stipendCurrency     String               @default("INR")
  stipendPeriod       StipendPeriod        @default(PER_MONTH)
  location            String
  workMode            WorkMode             @default(ON_SITE)
  requiredSkills      String               @db.Text
  vacancies           Int                  @default(1)
  applicationDeadline DateTime
  selectionProcess    String?              @db.Text
  status              OpportunityStatus    @default(DRAFT)
  isPPOApplicable     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter           Recruiter?           @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  eligibilityCriteria EligibilityCriteria?
  interviewRounds     InterviewRound[]
  applications        Application[]
  interviews          Interview[]
  offers              Offer[]
  savedOpportunities  SavedOpportunity[]

  @@map("internships")
  @@index([companyId])
  @@index([status])
  @@index([applicationDeadline])
}

model EligibilityCriteria {
  id                  Int         @id @default(autoincrement())
  jobId               Int?        @unique
  internshipId        Int?        @unique
  minCgpa             Decimal?    @db.Decimal(4, 2)
  minPercentage       Decimal?    @db.Decimal(5, 2)
  maxBacklogs         Int         @default(0)
  allowedCourses      String?     @db.Text // JSON string: ["MCA", "B.Tech"]
  allowedPrograms     String?     @db.Text // JSON string: ["Computer Applications", "Computer Science"]
  allowedDepartments  String?     @db.Text // JSON string: ["MCA", "CSE", "IT"]
  allowedSemesters    String?     @db.Text // JSON string: [5, 6]
  graduationYears     String?     @db.Text // JSON string: [2026, 2027]
  requiredSkills      String?     @db.Text // JSON string: ["Node.js", "React", "MySQL"]
  additionalCriteria  String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  job                 Job?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  internship          Internship? @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@map("eligibility_criteria")
}

// ==========================================
// APPLICATIONS & STATUS TRACKING
// ==========================================

model Application {
  id                  Int                       @id @default(autoincrement())
  studentId           Int
  opportunityType     OpportunityType
  jobId               Int?
  internshipId        Int?
  status              ApplicationStatus         @default(APPLIED)
  appliedAt           DateTime                  @default(now())
  coverLetter         String?                   @db.Text
  resumeDocumentId    Int?
  statusRemarks       String?                   @db.Text
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  student             Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job                 Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  internship          Internship?               @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  resumeDocument      Document?                 @relation(fields: [resumeDocumentId], references: [id], onDelete: SetNull)
  statusHistory       ApplicationStatusHistory[]
  interviews          Interview[]
  offers              Offer[]
  placements          Placement[]

  @@unique([studentId, jobId])
  @@unique([studentId, internshipId])
  @@map("applications")
  @@index([studentId])
  @@index([jobId])
  @@index([internshipId])
  @@index([status])
}

model ApplicationStatusHistory {
  id             Int                @id @default(autoincrement())
  applicationId  Int
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  changedById    Int?
  note           String?            @db.Text
  createdAt      DateTime           @default(now())

  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy      User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@map("application_status_histories")
  @@index([applicationId])
  @@index([changedById])
}

// ==========================================
// INTERVIEWS & ROUND MANAGEMENT
// ==========================================

model InterviewRound {
  id             Int                @id @default(autoincrement())
  jobId          Int?
  internshipId   Int?
  roundNumber    Int                @default(1)
  name           String
  type           InterviewRoundType @default(TECHNICAL)
  description    String?            @db.Text
  isEliminative  Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  job            Job?               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  internship     Internship?        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  interviews     Interview[]

  @@map("interview_rounds")
  @@index([jobId])
  @@index([internshipId])
}

model Interview {
  id              Int              @id @default(autoincrement())
  applicationId   Int
  roundId         Int?
  studentId       Int
  companyId       Int
  jobId           Int?
  internshipId    Int?
  recruiterId     Int?
  roundNumber     Int              @default(1)
  roundName       String
  interviewDate   DateTime
  startTime       DateTime
  endTime         DateTime
  mode            InterviewMode    @default(ONLINE)
  location        String?
  meetingLink     String?
  interviewerName String?
  notes           String?          @db.Text
  feedback        String?          @db.Text
  result          InterviewResult  @default(PENDING)
  status          InterviewStatus  @default(SCHEDULED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round           InterviewRound?  @relation(fields: [roundId], references: [id], onDelete: SetNull)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job             Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  internship      Internship?      @relation(fields: [internshipId], references: [id], onDelete: SetNull)
  recruiter       Recruiter?       @relation(fields: [recruiterId], references: [id], onDelete: SetNull)

  @@map("interviews")
  @@index([applicationId])
  @@index([studentId])
  @@index([companyId])
  @@index([interviewDate])
  @@index([status])
}

// ==========================================
// OFFERS & PLACEMENT OUTCOMES
// ==========================================

model Offer {
  id                    Int          @id @default(autoincrement())
  applicationId         Int
  studentId             Int
  companyId             Int
  jobId                 Int?
  internshipId          Int?
  offerDate             DateTime     @default(now())
  joiningDate           DateTime?
  salary                Decimal?     @db.Decimal(12, 2)
  stipend               Decimal?     @db.Decimal(10, 2)
  currency              String       @default("INR")
  location              String?
  designation           String
  offerLetterDocumentId Int?
  status                OfferStatus  @default(OFFERED)
  acceptanceDeadline    DateTime?
  respondedAt           DateTime?
  responseNotes         String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  application           Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student               Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job                   Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  internship            Internship?  @relation(fields: [internshipId], references: [id], onDelete: SetNull)
  offerDocument         Document?    @relation(fields: [offerLetterDocumentId], references: [id], onDelete: SetNull)
  placement             Placement?

  @@map("offers")
  @@index([studentId])
  @@index([companyId])
  @@index([applicationId])
  @@index([status])
}

model Placement {
  id            Int             @id @default(autoincrement())
  studentId     Int
  companyId     Int
  applicationId Int?
  jobId         Int?
  offerId       Int?            @unique
  placementDate DateTime        @default(now())
  packageAmount Decimal         @db.Decimal(12, 2)
  currency      String          @default("INR")
  joiningDate   DateTime?
  placementType PlacementType   @default(ON_CAMPUS)
  designation   String
  location      String?
  status        PlacementStatus @default(CONFIRMED)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application   Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  job           Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  offer         Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@map("placements")
  @@index([studentId])
  @@index([companyId])
  @@index([placementDate])
  @@index([status])
}

// ==========================================
// DOCUMENTS, NOTIFICATIONS & BOOKMARKS
// ==========================================

model Document {
  id              Int          @id @default(autoincrement())
  userId          Int
  studentId       Int?
  type            DocumentType
  title           String
  fileName        String
  fileKey         String       @unique
  fileUrl         String
  fileSize        Int
  mimeType        String
  isVerified      Boolean      @default(false)
  verifiedById    Int?
  verifiedAt      DateTime?
  rejectionReason String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  student         Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy      User?        @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  applications    Application[]
  offers          Offer[]

  @@map("documents")
  @@index([userId])
  @@index([studentId])
  @@index([type])
}

model Notification {
  id                Int              @id @default(autoincrement())
  recipientId       Int
  title             String
  message           String           @db.Text
  type              NotificationType @default(GENERAL)
  isRead            Boolean          @default(false)
  readAt            DateTime?
  relatedEntityType String?
  relatedEntityId   Int?
  actionUrl         String?
  createdAt         DateTime         @default(now())

  recipient         User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}

model SavedOpportunity {
  id              Int             @id @default(autoincrement())
  studentId       Int
  opportunityType OpportunityType
  jobId           Int?
  internshipId    Int?
  savedAt         DateTime        @default(now())

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job             Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  internship      Internship?     @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@unique([studentId, internshipId])
  @@map("saved_opportunities")
  @@index([studentId])
}

// ==========================================
// SYSTEM AUDIT & SETTINGS
// ==========================================

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  entity      String
  entityId    String
  oldValues   String?  @db.Text // JSON snapshot (NEVER stores passwords or credentials)
  newValues   String?  @db.Text // JSON snapshot (NEVER stores passwords or credentials)
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  group       String   @default("GENERAL")
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
  @@index([group])
}
