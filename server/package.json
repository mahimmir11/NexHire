{
  "name": "nexhire-server",
  "version": "1.0.0",
  "description": "Backend API server for NexHire — Internship & Placement Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:db": "tsx src/scripts/testDb.ts",
    "test:auth": "tsx src/scripts/testAuth.ts",
    "test:student": "tsx src/scripts/testStudentModule.ts",
    "test:company": "tsx src/scripts/testCompanyModule.ts",
    "test:opportunity": "tsx src/scripts/testOpportunityModule.ts",
    "test:application": "tsx src/scripts/testApplicationModule.ts",
    "test:recruitment": "tsx src/scripts/testRecruitmentModule.ts",
    "test:placement": "tsx src/scripts/testPlacementModule.ts",
    "seed": "tsx src/scripts/seed.ts",
    "verify:db": "tsx src/scripts/verifyDb.ts",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../prisma/schema.prisma"
  },
  "keywords": [
    "nexhire",
    "placement-management",
    "express",
    "typescript",
    "prisma",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
